{
  "name": "cardscanner",
  "version": "1.0.0",
  "private": true,
  "description": "Trading cards per Handykamera erkennen und als Sammlung erfassen",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "catalog": "tsx scripts/build-catalog.ts",
    "prices": "tsx scripts/build-prices.ts",
    "price-history": "tsx scripts/build-price-history.ts",
    "eval": "tsx scripts/eval-recognition.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "@supabase/supabase-js": "^2.118.0",
    "exceljs": "^4.4.0",
    "idb": "^8.0.3",
    "preact": "^10.29.8",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.0.0",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.64.0",
    "sharp": "^0.34.5",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.2.0"
  }
}
